{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Home Assistant",
            "type": "debugpy",
            "request": "launch",
            "module": "homeassistant",
            // justMyCode: true = only instrument code in the workspace (custom_components/)
            // This prevents debugpy from tracing all of HA's internals and blocking the event loop
            "justMyCode": true,
            "args": [
                "--debug",
                "-c",
                "config",
                "--skip-pip"
            ]
        },
        {
            "name": "Home Assistant (trace HA internals)",
            "type": "debugpy",
            "request": "launch",
            "module": "homeassistant",
            // justMyCode: false lets you step into HA's own code, but causes significant
            // event loop lag which can stall the UI loading screen
            "justMyCode": false,
            "args": [
                "--debug",
                "-c",
                "config",
                "--skip-pip"
            ]
        }
    ]
}